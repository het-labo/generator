{
  "name": "generator",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "generate:single": "NUXT_SINGLE_FILE=true nuxt generate && node scripts/patch-single-html-for-file-protocol.mjs .output/public",
    "generate:companies": "node scripts/generate-company-html.mjs",
    "check": "node scripts/check-signatures.mjs",
    "check:update": "node scripts/check-signatures.mjs --update",
    "preview": "nuxt preview",
    "deploy": "node deploy.cjs",
    "deploy:company": "node scripts/deploy-company.mjs",
    "shipit": "npm run generate && npm run deploy",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.35.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "nuxt": "^4.4.2",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1",
    "ftp-deploy": "^2.4.7",
    "nuxt-single-html": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wawoff2": "^2.0.1"
  }
}
